# PUBLIC client configuration, compiled into the app with:
#   flutter run --dart-define-from-file=.env
# Copy to .env (git-ignored). Everything here ends up inside the APK, so
# never put server secrets (service role key, SMS/FCM credentials) here.

APP_ENV=dev

# Local stack: `supabase start` prints these.
# * Android emulator: http://10.0.2.2:54321 (the host machine as the emulator sees it)
# * Real phone over USB: run `adb reverse tcp:54321 tcp:54321`, then use
#   http://127.0.0.1:54321. Debug builds only allow plain HTTP to these
#   addresses (android/app/src/debug/res/xml/network_security_config.xml), so a
#   LAN IP like 192.168.x.x will be blocked. That is deliberate.
SUPABASE_URL=http://10.0.2.2:54321
# Publishable ("anon") key. Safe to ship: Row Level Security protects data.
SUPABASE_PUBLISHABLE_KEY=

# Map tiles. Use a provider whose usage policy allows app traffic
# (e.g. MapTiler, Stadia Maps, Thunderforest) or self-hosted tiles.
# The OSMF tile.openstreetmap.org servers are NOT for apps.
TILE_URL_TEMPLATE=https://tiles.example.com/{z}/{x}/{y}.png

# Optional: Firebase Cloud Messaging (push alerts when the app is closed).
# From Firebase console > Project settings > Your apps > Android app.
# Leave empty to run without push; alerts then arrive only while the app is open.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=

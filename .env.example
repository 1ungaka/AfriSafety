# Server-side / local development secrets template.
# Copy to .env (git-ignored). In production, set these with `supabase secrets set`.
# NEVER put these values in the Flutter app.

# Supabase (local: printed by `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Cloud Messaging (service account JSON, base64-encoded) for dispatch-alert
FCM_SERVICE_ACCOUNT_B64=

# SMS gateway for send-sms (Phase 2): choose one
SMS_PROVIDER=clickatell
CLICKATELL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
